DATABASE_URL=your_database_url

SEED_USER1_NAME="User1"

SEED_USER2_NAME="User2"
SEED_USER2_EMAIL="user.2@gmail.com"
SEED_USER2_PASSWORD="pwd2"

SEED_USER3_NAME="User3"
SEED_USER3_EMAIL="user.3@gmail.com"
SEED_USER3_PASSWORD="pwd3"

AUTH_SECRET=your_auth_secret
CALENDAR_ICS_URL=

# Mail on a new drawing. Without both set, no mail is sent and uploads still work.
RESEND_API_KEY=
MAIL_FROM="FamilyScreen <familyscreen@your-domain.example>"

# Daily message written by Gemini (Google AI Studio). Without the key nothing is
# generated and the approved corpus is used exactly as before.
GEMINI_API_KEY=
# The default model is gemini-3.6-flash, set this variable to override it.
GEMINI_MODEL=

# One to three sentences about the household, so the generated line can be
# personal rather than merely correct.
HOUSEHOLD_CONTEXT=
